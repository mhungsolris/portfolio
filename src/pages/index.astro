---
import BaseLayout from "../layouts/BaseLayout.astro";
import ButtonLink from "../components/ButtonLink.astro";
import ContactCTA from "../components/ContactCTA.astro";
import ExperienceItem from "../components/ExperienceItem.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import TechnologyTag from "../components/TechnologyTag.astro";
import Icon from "../components/Icon.astro";
import { focusAreas, nowItems, projects, skillGroups } from "../data/portfolio";
const navItems = [
  ["home", "Home", "user"],
  ["experience", "Experience", "briefcase"],
  ["projects", "Projects", "code"],
  ["about", "About", "user"],
  ["education", "Education", "graduation"],
  ["resume", "CV", "download"],
  ["contact", "Contact", "mail"],
] as const;
const resumeUrl = "/Data_Engineer_Vu_Manh_Hung_CV.pdf";
---
<BaseLayout title="Vu Manh Hung (Solris) - Data Engineer"
  description="Personal technical homepage for Vu Manh Hung, also known as Solris, a Data Engineer in Hanoi building data pipelines, models, and notes around reliable data systems.">
  <div class="site">
    <header class="site-header">
      <nav class="shell nav" aria-label="Primary navigation">
        <a class="logo" href="#home" translate="no">Vu Manh Hung<span> / Solris</span></a>
        <div class="desktop-nav">
          {navItems.map(([id, label, icon]) => <a href={`#${id}`}><Icon name={icon} size={16} />{label}</a>)}
        </div>
        <div class="nav-actions">
          <button id="theme-toggle" class="icon-button" type="button" aria-label="Switch to light mode" aria-pressed="false">
            <span class="theme-sun"><Icon name="sun" /></span><span class="theme-moon"><Icon name="moon" /></span>
          </button>
          <button id="menu-toggle" class="icon-button mobile-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-menu">
            <span class="menu-open-icon"><Icon name="menu" /></span><span class="menu-close-icon" hidden><Icon name="x" /></span>
          </button>
        </div>
        <div id="mobile-menu" class="mobile-menu" hidden>
          {navItems.map(([id, label, icon]) => <a href={`#${id}`}><Icon name={icon} size={17} />{label}</a>)}
        </div>
      </nav>
    </header>

    <main id="main-content">
      <section class="shell hero" id="home">
        <div class="hero-copy">
          <p class="eyebrow">Data Engineer / Hanoi, Vietnam / Solris</p>
          <h1>Vu Manh Hung</h1>
          <h2>Data Engineer</h2>
          <p class="hero-intro">I build data pipelines, analytics-ready models, and technical notes around the systems I am learning, shipping, and improving over time.</p>
          <div class="button-row">
            <ButtonLink href="#projects">Selected Work <Icon name="arrow" /></ButtonLink>
            <ButtonLink href="#contact" variant="secondary">Contact</ButtonLink>
            <a class="text-link" href={resumeUrl} target="_blank" rel="noreferrer">Open CV <Icon name="external" size={15} /></a>
          </div>
          <div class="socials">
            <a href="https://github.com/mhungsolris" target="_blank" rel="noreferrer" aria-label="GitHub"><Icon name="github" /></a>
            <a href="https://linkedin.com/in/vm-hung/" target="_blank" rel="noreferrer" aria-label="LinkedIn"><Icon name="linkedin" /></a>
            <a href="mailto:vumanhhung1213@gmail.com" aria-label="Email"><Icon name="mail" /></a>
          </div>
        </div>
        <div class="portrait-wrap">
          <div class="portrait-ring">
            <img src="/avatar.png" alt="Vu Manh Hung" width="286" height="286" />
          </div>
          <div class="availability">
            <span aria-hidden="true"></span>Open to Data Engineer opportunities
          </div>
        </div>
        <a class="featured" href="#project-01">
          <div>
            <p class="eyebrow">01 / Featured <span>Selected highlight</span></p>
            <h3>{projects[0].title}</h3>
            <p>{projects[0].problem}</p>
          </div>
          <div class="featured-meta">
            <span>{projects[0].status}</span>
            <strong>Jump to project <Icon name="arrow" /></strong>
          </div>
        </a>
      </section>

      <section class="section alt" id="experience">
        <div class="shell">
          <SectionHeading number="01" title="Background" eyebrow="Experience"
            summary="A practical mix of client work, internal analytics projects, personal systems, and research-style data processing." />
          <div class="timeline">
            <ExperienceItem title="Project-based Data Engineer" context="L'INNO · Remote / Part-time" date="Mar 2025 – Present"
              body="Worked on API ingestion, cloud storage, warehouse loading, reporting data models, dashboard preparation, failed-load investigation, and backfill workflows across client and internal project contexts.">
              <div class="tags">{["Python", "REST API", "GCS", "BigQuery", "GitHub Actions"].map((tag) => <TechnologyTag label={tag} />)}</div>
            </ExperienceItem>
            <ExperienceItem title="Data Engineer" context="Savvycom · Full-time" date="Sep 2025 – Apr 2026" body={projects[1].decisions}>
              <div class="tags">{projects[1].tags.map((tag) => <TechnologyTag label={tag} />)}</div>
            </ExperienceItem>
            <ExperienceItem title="Data Platform Path" context="Direction"
              body="Currently focused on becoming stronger at reliable pipeline design, data modeling, orchestration, observability, and writing technical documentation that makes systems easier to understand." />
          </div>
        </div>
      </section>

      <section class="section" id="projects">
        <div class="shell" id="work">
          <SectionHeading number="02" title="Selected Work" eyebrow="Projects"
            summary="A collection of real work, internal projects, research, and personal builds. The writeups stay public-safe and avoid private data, credentials, internal URLs, or unverified metrics." />
          <div class="project-grid">
            {projects.map((project, index) => <ProjectCard {...project} number={String(index + 1).padStart(2, "0")} featured={index === 0} id={`project-${String(index + 1).padStart(2, "0")}`} />)}
          </div>
        </div>
      </section>

      <section class="section alt" id="about">
        <div class="shell about-grid">
          <div>
            <SectionHeading number="03" title="About" eyebrow="Introduction"
              summary="This site is my personal technical home: a place to show who I am, what I am working on, and how I think about data engineering work." />
            <div class="focus-list">{focusAreas.map((area) => <article><h3>{area.title}</h3><p>{area.description}</p></article>)}</div>
            <ButtonLink href="#projects" variant="secondary">Selected Work <Icon name="arrow" /></ButtonLink>
            <div class="now-list" id="now">
              <h3>Now / What I'm Doing</h3>
              <p>The current thread through my work is simple: build reliable data workflows, understand the tradeoffs, and document the parts that would matter to another engineer.</p>
              {nowItems.map((item) => <article><h3>{item.title}</h3><p>{item.description}</p></article>)}
            </div>
          </div>
          <aside class="skills-card" aria-labelledby="skills-heading">
            <h3 id="skills-heading">Toolbox</h3>
            <div class="skills-grid">
              {skillGroups.map((group) => <div><h4>{group.title}</h4><div class="tags">{group.skills.map((skill) => <TechnologyTag label={skill} />)}</div></div>)}
            </div>
          </aside>
        </div>
      </section>

      <section class="section" id="education">
        <div class="shell">
          <SectionHeading number="04" title="Education" />
          <article class="education-card">
            <div class="education-icon"><Icon name="graduation" size={28} /></div>
            <div>
              <h3>Hanoi University of Science and Technology</h3>
              <p>Bachelor of Engineering in Electronics and Telecommunications Engineering</p>
              <p class="specialization">Specialization: Computer Engineering · Degree Classification: Good</p>
            </div>
            <strong>2020 – 2025</strong>
          </article>
        </div>
      </section>

      <section class="section resume" id="resume">
        <div class="shell resume-inner">
          <div><p class="eyebrow">05 / Resume</p><h2>Data Engineer CV</h2><p>A concise overview of experience, skills, and selected work.</p></div>
          <div class="resume-actions">
            <a class="button light" href={resumeUrl} download><Icon name="download" /> Download CV</a>
            <a class="button outline-light" href={resumeUrl} target="_blank" rel="noreferrer">Open CV <Icon name="external" size={16} /></a>
          </div>
        </div>
      </section>
      <ContactCTA />
    </main>

    <footer>
      <div class="shell footer-grid">
        <div><a class="logo" href="#home">Vu Manh Hung <span>/ Solris</span></a><p>Data Engineer / Hanoi, Vietnam / Solris</p></div>
        <div><h3>Quick Links</h3>{navItems.slice(1).map(([id, label]) => <a href={`#${id}`}>{label}</a>)}<a href="#now">Now</a></div>
        <div><h3>Connect</h3><a href="https://github.com/mhungsolris" target="_blank" rel="noreferrer">GitHub</a><a href="https://linkedin.com/in/vm-hung/" target="_blank" rel="noreferrer">LinkedIn</a><a href="mailto:vumanhhung1213@gmail.com">Email</a></div>
      </div>
      <div class="shell copyright"><span>© 2026 Vu Manh Hung. Personal Technical Site.</span><span>Built with Astro &amp; TypeScript</span></div>
    </footer>
  </div>
</BaseLayout>

<script>
  const themeToggle = document.querySelector<HTMLButtonElement>("#theme-toggle");
  const syncThemeButton = () => {
    const light = document.documentElement.classList.contains("light");
    themeToggle?.setAttribute("aria-label", light ? "Switch to dark mode" : "Switch to light mode");
    themeToggle?.setAttribute("aria-pressed", String(light));
  };
  syncThemeButton();
  themeToggle?.addEventListener("click", () => {
    const light = document.documentElement.classList.toggle("light");
    try { localStorage.setItem("portfolio-theme", light ? "light" : "dark"); } catch {}
    syncThemeButton();
  });
  const menuToggle = document.querySelector<HTMLButtonElement>("#menu-toggle");
  const menu = document.querySelector<HTMLElement>("#mobile-menu");
  const setMenu = (open: boolean) => {
    if (menu) menu.hidden = !open;
    menuToggle?.setAttribute("aria-expanded", String(open));
    menuToggle?.setAttribute("aria-label", open ? "Close navigation menu" : "Open navigation menu");
    const openIcon = menuToggle?.querySelector<HTMLElement>(".menu-open-icon");
    const closeIcon = menuToggle?.querySelector<HTMLElement>(".menu-close-icon");
    if (openIcon) openIcon.hidden = open;
    if (closeIcon) closeIcon.hidden = !open;
  };
  menuToggle?.addEventListener("click", () => setMenu(menu?.hidden ?? false));
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMenu(false)));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu && !menu.hidden) { setMenu(false); menuToggle?.focus(); }
  });
  document.addEventListener("click", (event) => {
    if (event.target instanceof Node && !menu?.contains(event.target) && !menuToggle?.contains(event.target)) setMenu(false);
  });
  matchMedia("(min-width: 1041px)").addEventListener("change", (event) => { if (event.matches) setMenu(false); });
  document.querySelector<HTMLFormElement>("#contact-form")?.addEventListener("submit", (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const data = new FormData(form);
    const subject = encodeURIComponent("Portfolio enquiry from " + String(data.get("name") ?? ""));
    const body = encodeURIComponent(String(data.get("message") ?? "") + "\n\nFrom: " + String(data.get("name") ?? "") + "\nEmail: " + String(data.get("email") ?? ""));
    const status = document.querySelector<HTMLElement>("#contact-status");
    if (status) { status.hidden = false; status.textContent = "Email draft requested. If your email app did not open, use the email link beside this form."; }
    window.location.href = "mailto:vumanhhung1213@gmail.com?subject=" + subject + "&body=" + body;
  });
</script>
