---
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";
import { copy } from "../data/portfolio";
---
<section class="section alt" id="contact">
  <div class="shell contact-grid">
    <div>
      <SectionHeading number="06" title="Find me around the web." eyebrow="Contact"
        summary={copy.contactIntro} />
      <div class="contact-links">
        <a href="mailto:vumanhhung1213@gmail.com"><Icon name="mail" /> vumanhhung1213@gmail.com</a>
        <a href="https://github.com/mhungsolris" target="_blank" rel="noreferrer"><Icon name="github" /> GitHub</a>
        <a href="https://linkedin.com/in/vm-hung/" target="_blank" rel="noreferrer"><Icon name="linkedin" /> LinkedIn</a>
        <a href="/Data_Engineer_Vu_Manh_Hung_CV.pdf"><Icon name="download" /> Resume</a>
      </div>
    </div>
    <form id="contact-form" action="/api/contact" method="post">
      <label for="contact-name">Your name<input id="contact-name" name="name" autocomplete="name" required placeholder="Your name" maxlength="150" /></label>
      <label for="contact-email">Your email<input id="contact-email" name="email" autocomplete="email" type="email" required placeholder="you@example.com" maxlength="254" /></label>
      <label for="contact-message">What would you like to discuss?<textarea id="contact-message" name="message" required rows={5} placeholder="Tell me about the role or project..." maxlength="3000"></textarea></label>
      <div class="contact-trap" aria-hidden="true"><label for="contact-website">Website<input id="contact-website" name="website" tabindex="-1" autocomplete="off" /></label></div>
      <button class="button primary" type="submit"><span id="contact-submit-label">Send message</span> <Icon name="mail" /></button>
      <small>I'll reply to the email address you provide.</small>
      <small id="contact-status" role="status" aria-live="polite" hidden></small>
      <noscript><small>Please enable JavaScript to send this form, or use the email link.</small></noscript>
    </form>
  </div>
</section>
<style>
  .contact-trap { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  button:disabled { opacity: .65; cursor: wait; }
</style>
