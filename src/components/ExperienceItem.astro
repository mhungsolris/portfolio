---
import Icon from "./Icon.astro";
interface Props { title: string; context: string; body: string; date?: string; }
const { title, context, body, date } = Astro.props;
---
<article>
  <div class="timeline-marker"><Icon name="briefcase" size={18} /></div>
  <div class="job-head"><div><h3>{title}</h3><p>{context}</p></div>{date && <div class="date">{date}</div>}</div>
  <p class="timeline-copy">{body}</p>
  <slot />
</article>
